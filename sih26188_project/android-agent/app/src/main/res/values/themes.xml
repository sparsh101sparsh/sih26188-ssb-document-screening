<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Outdoor Sunlight-Legible Whitish Modern Theme -->
    <style name="Theme.SSBFieldCamera" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/accent_primary</item>
        <item name="colorPrimaryVariant">@color/accent_navy</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/accent_primary</item>
        <item name="colorSecondaryVariant">@color/accent_navy</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSurface">@color/surface_card</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:statusBarColor">@color/bg_main</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/surface_card</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">@color/bg_main</item>
    </style>

    <style name="Theme.SSBFieldCamera.FullScreen" parent="Theme.SSBFieldCamera">
        <item name="android:windowContentOverlay">@null</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>
</resources>
